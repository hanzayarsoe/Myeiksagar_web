# Copy to .env for local runs (optional if you export in the shell).
# Prefer a secrets *file* named `.env`. Do not create a `.env/` directory
# (some clones historically used `.env/` as a virtualenv — use `.venv/` instead).
# On Vercel: Project Settings → Environment Variables → add SECRET_KEY
# for Production, Preview, and Development.

# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# Local Flask only: set to 1/true to enable the debugger. Ignored on Vercel.
# FLASK_DEBUG=0
