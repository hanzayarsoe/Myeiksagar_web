rules_version = '2';

// Dictionary collection used by the translator UI and myeiksagar-collect.
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidWord(value) {
      return value is string
        && value.size() > 0
        && value.size() < 200;
    }

    match /data/{wordId} {
      // Public read for the translator
      allow get, list: if true;

      // Writes only create/update a single string field "value".
      // No deletes from clients — clean up in Firebase console if needed.
      allow create, update: if isValidWord(wordId)
        && request.resource.data.keys().hasOnly(['value'])
        && isValidWord(request.resource.data.value);

      allow delete: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
